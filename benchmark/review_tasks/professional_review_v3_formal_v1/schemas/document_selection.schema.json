{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PFAS review document selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selected_source_ids",
    "excluded_sources",
    "selection_rationale",
    "component_coverage"
  ],
  "properties": {
    "selected_source_ids": {
      "type": "array",
      "minItems": 6,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_sources": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "reason"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "enum": [
              "review_or_nonprimary",
              "task_irrelevant",
              "no_extractable_evidence",
              "duplicate_identity",
              "anchor_or_prohibited"
            ]
          }
        }
      }
    },
    "selection_rationale": {
      "type": "string"
    },
    "component_coverage": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "selected_source_ids",
          "rationale"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^RT(0[1-9]|10)-C[1-3]$"
          },
          "selected_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
