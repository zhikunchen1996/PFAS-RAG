{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PFAS review evidence extraction verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "record_id",
    "anchor_exclusion_violation",
    "field_assessments",
    "record_usable",
    "record_usable_rationale"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^RT(0[1-9]|10)$"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "anchor_exclusion_violation": {
      "type": "boolean"
    },
    "field_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_path",
          "status",
          "error_type",
          "reason"
        ],
        "properties": {
          "field_path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "contradicted"
            ]
          },
          "error_type": {
            "type": "string",
            "enum": [
              "none",
              "numeric_transcription",
              "unit",
              "qualifier",
              "endpoint_classification",
              "source_attribution",
              "other"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "record_usable": {
      "type": "boolean"
    },
    "record_usable_rationale": {
      "type": "string"
    }
  }
}
