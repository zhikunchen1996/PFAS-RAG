{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PFAS Web Search candidate-source packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "sources",
    "search_notes"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^RT(0[1-9]|10)$"
    },
    "sources": {
      "type": "array",
      "minItems": 6,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "citation",
          "year",
          "doi",
          "inspected_url",
          "publication_type",
          "publication_status",
          "access_scope",
          "covered_component_ids",
          "evidence_passages",
          "source_limitations"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^WEB[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "string"
          },
          "doi": {
            "type": "string"
          },
          "inspected_url": {
            "type": "string",
            "minLength": 1
          },
          "publication_type": {
            "type": "string",
            "enum": [
              "primary_experiment",
              "pilot_or_field_deployment",
              "modeling_or_life_cycle_study",
              "other_primary"
            ]
          },
          "publication_status": {
            "type": "string",
            "enum": [
              "peer_reviewed",
              "preprint",
              "conference_abstract",
              "technical_report",
              "unknown"
            ]
          },
          "access_scope": {
            "type": "string",
            "enum": [
              "full_text",
              "abstract",
              "publisher_page",
              "repository_record",
              "other_inspected_page"
            ]
          },
          "covered_component_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^RT(0[1-9]|10)-C[1-3]$"
            }
          },
          "evidence_passages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "locator_id",
                "passage",
                "page_or_section",
                "passage_type"
              ],
              "properties": {
                "locator_id": {
                  "type": "string",
                  "pattern": "^WEB[0-9]{2}-E[0-9]{2}$"
                },
                "passage": {
                  "type": "string",
                  "minLength": 1
                },
                "page_or_section": {
                  "type": "string"
                },
                "passage_type": {
                  "type": "string",
                  "enum": [
                    "verbatim",
                    "faithful_paraphrase"
                  ]
                }
              }
            }
          },
          "source_limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "search_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
